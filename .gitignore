/target
/gallery
/tmp
/dist
/coverage

# --bench-suite's per-run output (the checked-in reference lives at
# benches/baseline.json; a fresh bench.json is scratch, never committed)
/bench.json
.claude/worktrees/
.playwright-mcp/

# site/check.html's data file — generated fresh at each deploy
# (.github/workflows/deploy-web.yml's "Write version.json" step), never
# committed. See site/README.md's "Check for updates" section.
/site/version.json

# Storyboard run outputs (`--storyboard`, default `<board>.run/` beside the
# .toml — see CAPTURE.md's storyboard section). The storyboards themselves
# (scenarios/*.toml + fixtures) are checked in; their runs never are.
*.run/

# Per-world app-icon candidates (scripts/export-icons.sh). The GALLERY sheets,
# the 1024 masters and the legibility ladder are committed — they are what a
# preset gets judged from. The intermediate tile sizes are pure derivatives of
# the same deterministic run (about a minute to regenerate, byte-identical), so
# they stay untracked rather than bloating the history.
/assets/macos/candidates/tiles/*
!/assets/macos/candidates/tiles/*-1024.png

# The HTML-export Playwright harness bootstraps Playwright on first run
# (scripts/smoke-export-html.sh); its node_modules is scratch, never committed.
/test/export-html/node_modules/
/test/export-html/package-lock.json
.DS_Store

# Python bytecode from ad-hoc imports of the icon verifier
__pycache__/

# native-gate.sh's in-flight advisory marker (pid + start sha + start time),
# written while the gate runs and removed on every exit path. A stale one is
# harmless: its authority is the live PID inside it, checked with `kill -0`,
# never the file's mere existence.
/.orchestrator/native-gate.marker
