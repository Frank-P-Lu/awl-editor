# syntax=docker/dockerfile:1
# Build an x86_64 Linux binary of awl on a Debian bookworm base (glibc 2.36,
# older than Arch's, so the result runs on the laptop). Invoked with
# --platform linux/amd64 from the Apple-Silicon Mac (emulated via qemu).
# Extract the binary with:  --target export --output type=local,dest=dist
FROM rust:1-bookworm AS build
# The package names come from scripts/linux-deps.sh, shared with both
# workflows and the from-source bootstrap. Profile `compile`, not `test`: this
# stage only ever builds the binary and copies it out, so it needs no Vulkan
# driver. Copied in on its own layer, ahead of the sources, so an edit to
# src/ does not invalidate the apt layer.
COPY scripts/linux-deps.sh scripts/linux-build-deps.sh /src/scripts/
RUN /src/scripts/linux-build-deps.sh compile \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
# assets/ (embedded fonts + dictionaries) and shaders/ (wgsl) are pulled in at
# COMPILE time via include_bytes!/include_str! — the build fails without them.
# So are these top-level docs, samples/, and two site/ pages (embedded_docs.rs).
COPY assets ./assets
COPY shaders ./shaders
COPY samples ./samples
COPY GUIDE.md REFERENCE.md WORLDS.md CREDITS.md CAPTURE.md PHILOSOPHY.md ./
COPY site/reference.html site/guide.html ./site/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release && cp /src/target/release/awl /awl

# Tiny export stage so `--output type=local,dest=dist` drops just the binary
# into dist/awl without clobbering run.sh / README.txt / samples/.
FROM scratch AS export
COPY --from=build /awl /awl
